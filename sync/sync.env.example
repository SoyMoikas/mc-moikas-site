# Copy to sync.env (same folder as ptero-sync.py) and fill in. Keep this file private: chmod 600 sync.env

# Pterodactyl panel URL as seen FROM THE NAS (LAN address is fine)
PTERO_URL=http://192.168.1.239:PANEL_PORT

# Pterodactyl → Account → API Credentials → create key (starts with ptlc_)
PTERO_KEY=ptlc_xxxxxxxxxxxxxxxxxxxxxxxx

# The website
SITE_URL=https://play.moikas.cc

# Same value as the SYNC_SECRET secret in Cloudflare Pages
SYNC_SECRET=paste-the-long-random-string-here

# Where to ping game servers for player counts when Ptero reports 0.0.0.0 (127.0.0.1 = the NAS itself)
PING_HOST=127.0.0.1

# Optional: comma-separated egg variables to publish (defaults cover Minecraft versions/loaders)
# VARIABLES=MINECRAFT_VERSION,FORGE_VERSION

# Optional: how often (minutes) to sync player playtime/stats for levels and quests
# STATS_EVERY_MIN=10
